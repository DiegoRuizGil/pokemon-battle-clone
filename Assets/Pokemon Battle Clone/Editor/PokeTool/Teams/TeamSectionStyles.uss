.member-selector {
    flex-direction: row;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-top-width: 1px;
    border-left-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-top-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
    padding-right: 0;
    padding-left: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    justify-content: center;
}

.member-button {
    width: 68px;
    height: 68px;
    margin-right: 4px;
    padding: 2px;
}

.member-button > .unit-image {
    flex-grow: 1;
}

.member-button.selected {
    border-color: rgb(80, 150, 255);
    border-width: 2px;
}

.team-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.team-name {
    -unity-font-style: bold;
    font-size: 18px;
}

.member-editor {
}

.member-row {
    background-color: rgba(88, 88, 88, 0.98);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(31, 31, 31);
    border-right-color: rgb(31, 31, 31);
    border-top-color: rgb(31, 31, 31);
    border-bottom-color: rgb(31, 31, 31);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    justify-content: center;
    flex-direction: row;
}

.member-row > * {
    margin-right: 16px;
}

.info-column {
    background-color: rgba(255, 136, 177, 0.44);
    width: auto;
}

.moves-column {
    background-color: rgba(96, 222, 236, 0.48);
    width: 150px;
    justify-content: center;
}

.member-sprite {
    width: 100px;
    height: 100px;
    background-color: rgb(255, 138, 138);
}

.types-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.type-icon {
    margin-right: 4px;
}

.name-row {
    flex-direction: row;
}

.name-row > .unity-text-field {
    flex-grow: 1;
}

.level-field {
    width: 80px;
    background-color: rgba(112, 212, 223, 0.43);
}

.stats-column {
    width: 150px;
    background-color: rgb(42, 42, 42);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    align-content: flex-start;
    justify-content: center;
    cursor: link;
}

.stats-column * {
    cursor: link;
}

.stats-column:hover {
    border-color: rgba(128, 128, 128, 0.6);
}

.stat-row {
    flex-direction: row;
}

.stat-name {
    width: 32px;
    flex-shrink: 0;
    margin-right: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.stat-bar {
    flex-grow: 1;
    height: 8px;
    align-self: center;
}

.stat-bar-fill {
    height: 100%;
    border-radius: 4px;
}

.config-picker {
    height: 220px;
    margin-top: 4px;
}

.config-picker > .unity-list-view {
    flex-grow: 1;
}

.config-picker-current {
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.member-stats-editor { padding: 6px; }
.stats-params-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.stats-table-row { flex-direction: row; align-items: center; height: 22px; }

.stats-params-row .unity-base-field__label { min-width: 0; margin-right: 6px; }

.stats-level-field { flex-grow: 0; width: 100px; margin-right: 16px; }
.stats-nature-field { flex-grow: 0; width: 240px; }

.stats-col-name { width: 110px; flex-shrink: 0; -unity-text-align: middle-right; }
.stats-col-base { width: 36px; flex-shrink: 0; margin-right: 6px; -unity-text-align: middle-right; }
.stats-col-bar { flex-grow: 1; min-width: 80px; }
.stats-col-ev { width: 48px; flex-shrink: 0; margin: 0; }
.stats-col-ev-slider { flex-grow: 1; min-width: 100px; margin: 0 6px; }
.stats-col-iv { width: 40px; flex-shrink: 0; margin: 0; }
.stats-col-final { width: 44px; flex-shrink: 0; -unity-text-align: middle-right; }

.stats-remaining { overflow: visible; white-space: nowrap; }

.stats-header Label { -unity-font-style: bold; }
.stats-footer Label { -unity-font-style: italic; }

.stat-up { color: rgb(220, 120, 120); }
.stat-down { color: rgb(110, 160, 230); }
