.member-selector {
    flex-direction: row;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-top-width: 1px;
    border-left-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-top-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
    padding-right: 0;
    padding-left: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    justify-content: center;
}

.member-button {
    width: 68px;
    height: 68px;
    margin-right: 4px;
    padding: 2px;
}

.member-button > .unit-image {
    flex-grow: 1;
}

.member-button.selected {
    border-color: rgb(80, 150, 255);
    border-width: 2px;
}

.team-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.team-name {
    -unity-font-style: bold;
    font-size: 18px;
}

.member-editor {
    
}

.member-row {
    background-color: rgba(88, 88, 88, 0.98);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(31, 31, 31);
    border-right-color: rgb(31, 31, 31);
    border-top-color: rgb(31, 31, 31);
    border-bottom-color: rgb(31, 31, 31);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    justify-content: center;
    flex-direction: row;
}

.member-row > * {
    margin-right: 16px;
}

.info-column {
    background-color: rgba(255, 136, 177, 0.44);
    width: auto;
}

.moves-column {
    background-color: rgba(96, 222, 236, 0.48);
    width: 150px;
    justify-content: center;
}

.stats-column {
    background-color: rgb(42, 42, 42);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

.member-sprite {
    width: 100px;
    height: 100px;
    background-color: rgb(255, 138, 138);
}

.types-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.type-icon {
    margin-right: 4px;
}

.name-row {
    flex-direction: row;
}

.name-row > .unity-text-field {
    flex-grow: 1;
}

.level-field {
    width: 80px;
    background-color: rgba(112, 212, 223, 0.43);
}

.stat-row {
    flex-direction: row;
}

.stat-name {
    width: 32px;
}

.stat-value {
    width: 40px;
    -unity-text-align: middle-right;
}

.config-picker {
    height: 220px;
    margin-top: 4px;
}

.config-picker > .unity-list-view {
    flex-grow: 1;
}
